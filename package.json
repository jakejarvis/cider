{
  "name": "cider",
  "version": "1.0.0",
  "description": "Opinionated macOS developer environment setup with a beautiful TUI",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "cider": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "build": "bun scripts/build.ts",
    "build:arm64": "bun scripts/build.ts --arm64",
    "build:x64": "bun scripts/build.ts --x64",
    "build:current": "bun scripts/build.ts --current"
  },
  "dependencies": {
    "@clack/prompts": "1.2.0",
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.8",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.8"
}
